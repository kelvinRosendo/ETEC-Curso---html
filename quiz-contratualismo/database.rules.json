{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        "state": {
          ".write": "auth != null && ((!data.exists() && newData.child('owner').val() === auth.uid) || (data.child('owner').val() === auth.uid && newData.child('owner').val() === auth.uid))",
          ".validate": "newData.hasChildren(['owner','status','index','at'])"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name','score','hits','answerQ','joined']) && newData.child('name').isString() && newData.child('name').val().length <= 40"
          }
        }
      }
    }
  }
}